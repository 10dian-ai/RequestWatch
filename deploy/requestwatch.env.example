# 首次启动默认值；之后在 Web UI“设置”管理，data_dir/settings.json 的保存值优先。
# Web UI 默认 7030，可由防火墙限制为管理网络访问。
RW_HOST=0.0.0.0
RW_PORT=7030
RW_DATA_DIR=/var/lib/requestwatch
RW_CAPTURE=true
RW_INTERFACES=any
RW_QUEUE_NUM=7030
RW_MAX_RECORDS=10000
# 除管理端口和代理端口外，始终排除的源/目标端口；SSH 非22时追加实际端口。
RW_PROTECTED_PORTS=22
RW_PROXY=true
RW_PROXY_PORT=8080
# 容器接入时可在 Web UI“设置”将代理监听改为 0.0.0.0 或宿主机 bridge IP。
RW_PROXY_HOST=127.0.0.1
# 如代理可从其他机器访问，配置user:password，并限制防火墙来源。
# RW_PROXY_AUTH=requestwatch:change-to-a-long-random-password
# 生效令牌同步到 /var/lib/requestwatch/admin-token；可在 Web UI“设置”轮换。
# RW_TOKEN=at-least-16-random-characters
